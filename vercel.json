{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app.main:app",
      "functions": {
        "backend/app/main.py": {
          "maxDuration": 10,
          "excludeFiles": "{frontend/**,.venv/**,.git/**,docs/**,backend/tests/**,**/__pycache__/**,.pytest_cache/**,.ruff_cache/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
